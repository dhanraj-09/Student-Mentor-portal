# Root Environment (for docker-compose)

# Environment
NODE_ENV=development

# Backend
PORT=8080

# Database (MySQL on Aiven — remote, so compose does not run a local DB)
DB_HOST=your-service.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your-db-password
DB_NAME=defaultdb
DB_SSL_CA=ca.pem
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT (dual token: short-lived access + long-lived refresh)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
ACCESS_TOKEN_EXPIRY=30m
REFRESH_TOKEN_EXPIRY=7d

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080
