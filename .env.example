# Root Environment (for docker-compose)

# Environment
NODE_ENV=development

# Backend
PORT=8080

# Database (MySQL on Aiven — remote, so compose does not run a local DB)
DB_HOST=your-service.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your-db-password
DB_NAME=defaultdb
DB_SSL_CA=ca.pem
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT (dual token: short-lived access + long-lived refresh)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
ACCESS_TOKEN_EXPIRY=30m
REFRESH_TOKEN_EXPIRY=7d

# LiveKit (WebRTC media for meeting video calls)
#
# Without all three the backend still runs, but `config.livekit.configured` is
# false and joining a call fails with LIVEKIT_UNAVAILABLE rather than an error
# at boot — so an unset value here looks like a broken feature, not a crash.
# The API secret signs join tokens and must never be exposed to the browser.
# In production LIVEKIT_URL has to be wss://.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_TOKEN_TTL_SECONDS=300

# Logging (error | warn | info | debug; defaults to info in production)
LOG_LEVEL=debug

# Reverse proxy hops in front of the app (0 = none). Set to 1 behind
# Vercel/Railway/nginx so rate limits key on the real client IP.
TRUST_PROXY=0

# Rate limiting
#
# Login attempts are counted per client IP. Behind a reverse proxy (the Vite
# dev proxy, Vercel, nginx) every request arrives from the proxy's address
# unless Express `trust proxy` is set, so all users share one bucket — raise
# the login limit for local multi-device testing.
RATE_LIMIT_WINDOW_MS=1800000
RATE_LIMIT_MAX_REQUESTS=1000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_REQUESTS=25

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080
