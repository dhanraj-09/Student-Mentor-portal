# Environment
NODE_ENV=development

# Server
PORT=8080

# Database Configuration (MySQL on Aiven)
DB_HOST=your-service.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your-db-password
DB_NAME=defaultdb

# Aiven requires SSL. Download ca.pem from the Aiven console and place it in
# packages/backend/ (it is git-ignored by the root *.pem rule).
DB_SSL_CA=ca.pem
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT Configuration
# Two separate secrets: one signs the short-lived access token, the other the
# long-lived refresh token. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
ACCESS_TOKEN_EXPIRY=30m
REFRESH_TOKEN_EXPIRY=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=1800000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=info
