{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./src",
    "declaration": true,
    "emitDeclarationOnly": true,
    "paths": {
      "@/*": ["./*"],
      "@types/*": ["./types/*"],
      "@constants/*": ["./constants/*"],
      "@validation/*": ["./validation/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
